--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -1189,9 +1189,9 @@
 	return 0;
 }

-static bool r8s_qca_lab_baud_ack;
-module_param_named(r8s_qca_lab_baud_ack, r8s_qca_lab_baud_ack, bool, 0400);
-MODULE_PARM_DESC(r8s_qca_lab_baud_ack, "Lab QCA6390 version115200 then flow-gated3M, default off");
+static bool r8s_qca_lab_baud20;
+module_param_named(r8s_qca_lab_baud20, r8s_qca_lab_baud20, bool, 0400);
+MODULE_PARM_DESC(r8s_qca_lab_baud20, "Lab QCA6390 3M baud delay20ms and version, default off");

 static int qca_recv_event(struct hci_dev *hdev, struct sk_buff *skb)
 {
@@ -1200,7 +1200,7 @@


 	/* Opt-in: baud response only; no addresses or unrelated payloads. */
-	if (r8s_qca_lab_baud_ack && skb->len >= 5 &&
+	if (r8s_qca_lab_baud20 && skb->len >= 5 &&
 	    skb->data[0] == HCI_EV_CMD_COMPLETE &&
 	    get_unaligned_le16(skb->data + 3) == 0xfc48)
 		bt_dev_warn(hdev, "LAB baud ACK len=%u return=%*ph", skb->len,
@@ -1376,6 +1376,15 @@
 		usleep_range(1000, 10000);
 		break;

+	case QCA_QCA6390:
+		if (r8s_qca_lab_baud20) {
+			bt_dev_warn(hdev, "LAB baud delay20ms after TX drain; host switch next");
+			msleep(20);
+		} else {
+			msleep(300);
+		}
+		break;
+
 	default:
 		msleep(300);
 	}
@@ -1872,7 +1881,7 @@
 	struct qca_serdev *qcadev;
 	const char *soc_name;

-	if (r8s_qca_lab_baud_ack &&
+	if (r8s_qca_lab_baud20 &&
 	    (soc_type != QCA_QCA6390 || !hu->serdev ||
 	     qca_get_speed(hu, QCA_INIT_SPEED) != 115200 ||
 	     qca_get_speed(hu, QCA_OPER_SPEED) != 3000000))
@@ -1929,7 +1938,7 @@

 	clear_bit(QCA_SSR_TRIGGERED, &qca->flags);

-	if (r8s_qca_lab_baud_ack) {
+	if (r8s_qca_lab_baud20) {
 		ret = qca_set_speed(hu, QCA_INIT_SPEED);
 		if (ret)
 			goto out;
@@ -2049,7 +2058,7 @@
 	}

 out:
-	if (r8s_qca_lab_baud_ack) {
+	if (r8s_qca_lab_baud20) {
 		bt_dev_warn(hdev, "LAB version-first abort ret=%d; no retry/TLV/NVM", ret);
 		return ret ? ret : -ECANCELED;
 	}
