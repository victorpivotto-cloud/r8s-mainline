--- a/drivers/tty/serial/samsung_tty.c
+++ b/drivers/tty/serial/samsung_tty.c
@@ -1466,6 +1466,11 @@
 	[15] = 0xFFDF,
 };

+/* r8s laboratory only; default keeps the existing 3M ceiling. */
+static bool r8s_uart_lab3200000;
+module_param_named(r8s_uart_lab3200000, r8s_uart_lab3200000, bool, 0600);
+MODULE_PARM_DESC(r8s_uart_lab3200000, "Lab r8s BT UART 3.2M ceiling and divisor log, default off");
+
 static void s3c24xx_serial_set_termios(struct uart_port *port,
 				       struct ktermios *termios,
 				       const struct ktermios *old)
@@ -1475,6 +1480,11 @@
 	struct clk *clk = ERR_PTR(-EINVAL);
 	unsigned long flags;
 	unsigned int baud, quot;
+	unsigned int requested;
+	u32 lab_brdiv = 0, lab_frac = 0, lab_afc = 0;
+	bool r8s_lab = READ_ONCE(r8s_uart_lab3200000) &&
+		port->mapbase == 0x10840000 &&
+		of_device_is_compatible(port->dev->of_node, "samsung,exynos850-uart");
 	unsigned int udivslot = 0;
 	u32 ulcon, umcon;
 	u8 clk_sel = 0;
@@ -1489,7 +1499,9 @@
 	 * Ask the core to calculate the divisor for us.
 	 */

-	baud = uart_get_baud_rate(port, termios, old, 0, 3000000);
+	requested = tty_termios_baud_rate(termios);
+	baud = uart_get_baud_rate(port, termios, old, 0,
+				 r8s_lab ? 3200000 : 3000000);
 	quot = s3c24xx_serial_getclk(ourport, baud, &clk, &clk_sel);
 	if (baud == 38400 && (port->flags & UPF_SPD_MASK) == UPF_SPD_CUST)
 		quot = port->custom_divisor;
@@ -1585,6 +1597,12 @@
 	if (ourport->info->has_divslot)
 		wr_regl(port, S3C2443_DIVSLOT, udivslot);

+	if (r8s_lab) {
+		lab_brdiv = rd_regl(port, S3C2410_UBRDIV);
+		lab_frac = rd_regl(port, S3C2443_DIVSLOT);
+		lab_afc = !!(rd_regl(port, S3C2410_UMCON) & S3C2410_UMCOM_AFC);
+	}
+
 	dev_dbg(port->dev,
 		"uart: ulcon = 0x%08x, ucon = 0x%08x, ufcon = 0x%08x\n",
 		rd_regl(port, S3C2410_ULCON),
@@ -1619,6 +1637,11 @@
 		port->ignore_status_mask |= RXSTAT_DUMMY_READ;

 	uart_port_unlock_irqrestore(port, flags);
+	if (r8s_lab)
+		dev_info(port->dev,
+			 "LAB UART requested=%u selected=%u declared_clk=%lu brdiv=%u frac=%u afc=%u\n",
+			 requested, baud, ourport->baudclk_rate,
+			 lab_brdiv, lab_frac, lab_afc);
 }

