+/* Restore before devres releases the exclusively acquired descriptor. */
+static void qca_lab_rts_restore(void *data)
+{
+	struct gpio_desc *rts = data;
+
+	gpiod_set_value_cansleep(rts, 0);
+	if (gpiod_get_value_cansleep(rts) != 0)
+		pr_err("Bluetooth: LAB RTS cleanup LOW readback failed\n");
+}
+
+static int qca_lab_rts_set(struct hci_uart *hu, int value)
+{
+	struct qca_serdev *qcadev = serdev_device_get_drvdata(hu->serdev);
+	int observed;
+
+	if (!qcadev->lab_rts)
+		return -ENODEV;
+	gpiod_set_value_cansleep(qcadev->lab_rts, value);
+	observed = gpiod_get_value_cansleep(qcadev->lab_rts);
+	bt_dev_warn(hu->hdev, "LAB GPIO RTS requested=%d observed=%d ns=%llu",
+		    value, observed, ktime_get_ns());
+	return observed == value ? 0 : -EIO;
+}
