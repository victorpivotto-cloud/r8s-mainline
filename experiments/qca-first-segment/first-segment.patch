+/* Diagnostic only: one synchronous segment, never a complete download. */
+int qca_lab_first_segment(struct hci_dev *hdev)
+{
+	const struct firmware *fw;
+	const struct tlv_type_hdr *tlv;
+	const struct tlv_type_patch *patch;
+	u32 type_len;
+	int ret;
+
+	ret = request_firmware(&fw, "qca/htbtfw20.tlv", &hdev->dev);
+	if (ret)
+		return ret;
+	if (fw->size <= MAX_SIZE_PER_TLV_SEGMENT ||
+	    fw->size < sizeof(*tlv) + sizeof(*patch)) {
+		ret = -EINVAL;
+		goto out;
+	}
+	tlv = (const struct tlv_type_hdr *)fw->data;
+	patch = (const struct tlv_type_patch *)tlv->data;
+	type_len = le32_to_cpu(tlv->type_len);
+	if ((type_len & 0xff) != TLV_TYPE_PATCH ||
+	    (type_len >> 8) != fw->size - sizeof(*tlv) ||
+	    le16_to_cpu(patch->product_id) != 0x10 ||
+	    le16_to_cpu(patch->rom_build) != 0x0200) {
+		ret = -EINVAL;
+		goto out;
+	}
+	bt_dev_warn(hdev, "LAB one segment begin size=%u; no remainder/NVM",
+		    MAX_SIZE_PER_TLV_SEGMENT);
+	ret = qca_tlv_send_segment(hdev, MAX_SIZE_PER_TLV_SEGMENT, fw->data,
+				   QCA_SKIP_EVT_NONE, QCA_QCA6390);
+	bt_dev_warn(hdev, "LAB one segment end ret=%d; diagnostic abort", ret);
+	if (!ret)
+		ret = -ECANCELED;
+out:
+	release_firmware(fw);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qca_lab_first_segment);

