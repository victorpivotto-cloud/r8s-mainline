+static int qca_lab_build_info(struct hci_dev *hdev)
+{
+	const u8 cmd = EDL_GET_BUILD_INFO_CMD;
+	struct sk_buff *skb;
+	int ret;
+
+	/* Same read-only opcode/subcommand as btqca; no label/payload logging. */
+	skb = __hci_cmd_sync_ev(hdev, EDL_PATCH_CMD_OPCODE, EDL_PATCH_CMD_LEN,
+				&cmd, 0, HCI_INIT_TIMEOUT);
+	if (IS_ERR(skb))
+		return PTR_ERR(skb);
+	bt_dev_warn(hdev, "LAB build-info response len=%u header=%*ph", skb->len,
+		    (int)min_t(unsigned int, skb->len, 3), skb->data);
+	/* Do not assume success or string format from a completed transport. */
+	ret = skb->len >= 2 ? 0 : -EILSEQ;
+	kfree_skb(skb);
+	return ret;
+}
