+
+	/* Sysfs reads must not release the clamp for a disabled governor. */
+	if (!zone->enabled)
+		return -EAGAIN;
 
 	if (time_after(jiffies, zone->last_sample + 5 * HZ)) {
 		zone->healthy = false;
@@ -100,8 +107,12 @@
 	zone->bad_reads = 0;
 	if (!zone->healthy) {
