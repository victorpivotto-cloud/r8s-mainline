diff --git a/drivers/bus/mhi/host/boot.c b/drivers/bus/mhi/host/boot.c
index 9dcc71848..df435c1c2 100644
--- a/drivers/bus/mhi/host/boot.c
+++ b/drivers/bus/mhi/host/boot.c
@@ -16,6 +16,7 @@
 #include <linux/random.h>
 #include <linux/slab.h>
 #include <linux/wait.h>
+#include <linux/exynos-s2mpu-wifi.h>
 #include "internal.h"
 
 /* Setup RDDM vector table for RDDM transfer and program RXVEC */
@@ -269,6 +270,22 @@ static int mhi_fw_load_bhi(struct mhi_controller *mhi_cntrl,
 			   mhi_read_reg_field(mhi_cntrl, base, BHI_STATUS,
 					      BHI_STATUS_MASK, &tx_status) || tx_status,
 			   msecs_to_jiffies(mhi_cntrl->timeout_ms));
+	/* r8s: diagnostico do S2MPU — o codigo de erro vem do proprio QCA6390 */
+	{
+		u32 ee = 0xdeadbeef, st = 0xdeadbeef, ec = 0xdeadbeef;
+		u32 d1 = 0xdeadbeef, d2 = 0xdeadbeef, d3 = 0xdeadbeef;
+
+		mhi_read_reg(mhi_cntrl, base, BHI_EXECENV, &ee);
+		mhi_read_reg(mhi_cntrl, base, BHI_STATUS, &st);
+		mhi_read_reg(mhi_cntrl, base, BHI_ERRCODE, &ec);
+		mhi_read_reg(mhi_cntrl, base, BHI_ERRDBG1, &d1);
+		mhi_read_reg(mhi_cntrl, base, BHI_ERRDBG2, &d2);
+		mhi_read_reg(mhi_cntrl, base, BHI_ERRDBG3, &d3);
+		dev_info(dev,
+			 "BHI fim: wait=%d tx_status=%u EXECENV=0x%x STATUS=0x%x ERRCODE=0x%x DBG=0x%x/0x%x/0x%x pm=0x%x\n",
+			 ret, tx_status, ee, st, ec, d1, d2, d3,
+			 mhi_cntrl->pm_state);
+	}
 	if (MHI_PM_IN_ERROR_STATE(mhi_cntrl->pm_state))
 		goto invalid_pm_state;
 
@@ -345,6 +362,8 @@ int mhi_alloc_bhie_table(struct mhi_controller *mhi_cntrl,
 						  GFP_KERNEL);
 		if (!mhi_buf->buf)
 			goto error_alloc_segment;
+		/* r8s: o endpoint le estes segmentos por DMA (ver BHI acima) */
+		exynos990_s2mpu_wifi_grant(mhi_buf->dma_addr, vec_size, true);
 	}
 
 	img_info->bhi_vec = img_info->mhi_buf[segments - 1].buf;
@@ -462,7 +481,20 @@ void mhi_fw_load_handler(struct mhi_controller *mhi_cntrl)
 
 	/* Download image using BHI */
 	memcpy(buf, fw_data, size);
+	/*
+	 * No Exynos 990 o S2MPU bloqueia a leitura que o endpoint faz deste
+	 * buffer; sem a concessao o BHI devolve "Image transfer failed".
+	 * Fora desse SoC a funcao e um stub vazio.
+	 */
+	exynos990_s2mpu_wifi_grant(dma_addr, size, true);
+	dev_info(dev, "BHI: buffer DMA 0x%llx, %zu bytes\n",
+		 (u64)dma_addr, size);
 	ret = mhi_fw_load_bhi(mhi_cntrl, dma_addr, size);
+	/*
+	 * MEDIDO 13/09: revogar aqui derruba o link (o SBL ainda le do buffer
+	 * depois de BHI_STATUS=SUCCESS). Fica concedido. Vaza permissao sobre
+	 * paginas ja liberadas — aceitavel em bancada, nao no estado final.
+	 */
 	dma_free_coherent(mhi_cntrl->cntrl_dev, size, buf, dma_addr);
 
 	/* Error or in EDL mode, we're done */
@@ -534,9 +566,12 @@ int mhi_download_amss_image(struct mhi_controller *mhi_cntrl)
 	if (!image_info)
 		return -EIO;
 
+	dev_info(dev, "AMSS: baixando via BHIE, tabela em 0x%llx\n",
+		 (u64)image_info->mhi_buf[image_info->entries - 1].dma_addr);
 	ret = mhi_fw_load_bhie(mhi_cntrl,
 			       /* Vector table is the last entry */
 			       &image_info->mhi_buf[image_info->entries - 1]);
+	dev_info(dev, "AMSS: BHIE ret=%d\n", ret);
 	if (ret) {
 		dev_err(dev, "MHI did not load AMSS, ret:%d\n", ret);
 		write_lock_irq(&mhi_cntrl->pm_lock);
diff --git a/drivers/bus/mhi/host/pm.c b/drivers/bus/mhi/host/pm.c
index 11c0e751f..d7e4267cd 100644
--- a/drivers/bus/mhi/host/pm.c
+++ b/drivers/bus/mhi/host/pm.c
@@ -1266,6 +1266,12 @@ int mhi_sync_power_up(struct mhi_controller *mhi_cntrl)
 			   MHI_PM_IN_ERROR_STATE(mhi_cntrl->pm_state),
 			   msecs_to_jiffies(timeout_ms));
 
+	/* r8s: saber se saiu por modo de missao, por erro, ou por prazo */
+	dev_info(mhi_cntrl->cntrl_dev,
+		 "power_up fim: ee=%d (%s) pm=0x%x timeout=%ums\n",
+		 mhi_cntrl->ee, TO_MHI_EXEC_STR(mhi_cntrl->ee),
+		 mhi_cntrl->pm_state, timeout_ms);
+
 	ret = (MHI_IN_MISSION_MODE(mhi_cntrl->ee)) ? 0 : -ETIMEDOUT;
 	if (ret)
 		mhi_power_down(mhi_cntrl, false);
