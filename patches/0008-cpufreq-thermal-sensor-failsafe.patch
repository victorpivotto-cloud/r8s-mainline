+/* ready runs after the core has initialized the policy's QoS constraints. */
+static void z3s_cpufreq_ready(struct cpufreq_policy *policy)
+{
+	struct z3s_cluster *cl = policy->driver_data;
+	struct thermal_cooling_device *cooling;
+	int ret;
+
+	mutex_lock(&z3s_sensor_lock);
+	if (cl->sensor_max_added) {
+		mutex_unlock(&z3s_sensor_lock);
+		return;
+	}
+	/* Start clamped until the sensor module establishes healthy readings. */
+	ret = freq_qos_add_request(&policy->constraints, &cl->sensor_max,
+				   FREQ_QOS_MAX, cl->khz[0]);
+	if (ret < 0) {
+		pr_err("exynos990-cpufreq: cpu%u sensor QoS failed: %d\n", policy->cpu, ret);
+		mutex_unlock(&z3s_sensor_lock);
+		return;
+	}
+	cl->sensor_max_added = true;
+	cl->failsafe_active = true;
+	mutex_unlock(&z3s_sensor_lock);
+	/* Registration can call back into the sensor: never hold sensor_lock. */
+	cooling = cpufreq_cooling_register(policy);
+	if (IS_ERR(cooling)) {
+		pr_err("exynos990-cpufreq: cpu%u cooling unavailable: %ld\n",
+		       policy->cpu, PTR_ERR(cooling));
+		cooling = NULL;
+	}
+	mutex_lock(&z3s_sensor_lock);
+	cl->cooling = cooling;
+	mutex_unlock(&z3s_sensor_lock);
+}
+
 static void z3s_cpufreq_exit(struct cpufreq_policy *policy)
 {
+	struct z3s_cluster *cl = policy->driver_data;
+	struct thermal_cooling_device *cooling;
+
+	mutex_lock(&z3s_sensor_lock);
+	cooling = cl->cooling;
+	cl->cooling = NULL;
+	mutex_unlock(&z3s_sensor_lock);
+	cpufreq_cooling_unregister(cooling);
+	mutex_lock(&z3s_sensor_lock);
+	if (cl->sensor_max_added) {
+		freq_qos_remove_request(&cl->sensor_max);
+		cl->sensor_max_added = false;
+	}
+	mutex_unlock(&z3s_sensor_lock);
 	kfree(policy->freq_table);
 }
 
