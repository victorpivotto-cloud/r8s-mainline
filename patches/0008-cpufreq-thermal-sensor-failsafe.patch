+/* Caller owns sensor_lock. QoS is independent of the governor's request. */
+static int z3s_sensor_apply(struct z3s_cluster *cl)
+{
+	bool active = !cl->sensor_healthy || !cl->cooling ||
+		time_after(jiffies, cl->last_report + 5 * HZ);
+	int ret;
+
+	if (!cl->sensor_max_added)
+		return -ENODEV;
+	ret = freq_qos_update_request(&cl->sensor_max,
+			active ? cl->khz[0] : FREQ_QOS_MAX_DEFAULT_VALUE);
+	if (ret < 0)
+		return ret;
+	if (active != cl->failsafe_active)
+		pr_warn("exynos990-cpufreq: cpu%u sensor failsafe %s\n",
+			cl->first_cpu, active ? "engaged" : "released");
+	cl->failsafe_active = active;
+	return 0;
+}
+
+int exynos990_cpufreq_sensor_report(unsigned int cpu, bool healthy)
+{
+	struct z3s_cluster *cl = cluster_for_cpu(cpu);
+	int ret;
+
+	if (!cl)
+		return -EINVAL;
+	mutex_lock(&z3s_sensor_lock);
+	cl->sensor_healthy = healthy;
+	cl->last_report = jiffies;
+	ret = z3s_sensor_apply(cl);
+	mutex_unlock(&z3s_sensor_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(exynos990_cpufreq_sensor_report);
+
+static void z3s_sensor_watchdog(struct work_struct *work)
+{
+	unsigned int i;
+
+	mutex_lock(&z3s_sensor_lock);
+	for (i = 0; i < ARRAY_SIZE(clusters); i++)
+		if (clusters[i].sensor_max_added)
+			z3s_sensor_apply(&clusters[i]);
+	mutex_unlock(&z3s_sensor_lock);
+	schedule_delayed_work(&z3s_sensor_work, HZ);
+}
+
+static int z3s_failsafe_mask_get(char *buf, const struct kernel_param *kp)
+{
+	unsigned int i, mask = 0;
+
+	mutex_lock(&z3s_sensor_lock);
+	for (i = 0; i < ARRAY_SIZE(clusters); i++)
+		if (clusters[i].failsafe_active)
+			mask |= BIT(i);
+	mutex_unlock(&z3s_sensor_lock);
+	return sysfs_emit(buf, "%u\n", mask);
+}
+
+static const struct kernel_param_ops z3s_failsafe_mask_ops = {
